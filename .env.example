# Copy to .env for local dev.
# Production: add the same VITE_* keys in your host dashboard, then rebuild (Vite embeds them at build time).

# --- Supabase (публічні — лише для браузера) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# --- EmailJS ---
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_ADMIN_TEMPLATE_ID=
VITE_ADMIN_EMAIL=perfab.ua@gmail.com

# Optional
VITE_UAH_PER_USD=42
VITE_GA_MEASUREMENT_ID=G-VRFQSX71WS
